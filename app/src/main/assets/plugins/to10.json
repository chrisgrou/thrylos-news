{
  "schemaVersion": 1,
  "id": "to10-olympiacos",
  "name": "to10 — Ολυμπιακός",
  "homepage": "https://www.to10.gr",
  "enabled": true,
  "discovery": {
    "type": "html-list",
    "url": "https://www.to10.gr/team/olympiacos/",
    "maxItems": 30
  },
  "listSelectors": {
    "item": "[itemprop=itemListElement]",
    "link": "meta[itemprop=url]@content",
    "title": "h3",
    "image": "figure img@src",
    "date": "time.post-date"
  },
  "article": {
    "title": "h1.o-head",
    "author": ".td-post-author-name",
    "date": "meta[property=article:published_time]@content",
    "leadImage": "img.wp-post-image@src",
    "content": "div.postbody",
    "remove": [
      ".google-widget",
      ".adrow",
      "[id^=inside_intext]",
      "#moxtv",
      ".newtop",
      ".billboard-row",
      ".tags",
      ".related-articles",
      ".related-posts-bottom",
      ".google-news",
      ".articles-pop-now-must",
      ".wrapsocial"
    ]
  },
  "urlRules": {
    "deny": ["/matchcenter/"],
    "stripQueryParams": ["utm_source", "utm_medium", "utm_campaign", "fbclid"]
  },
  "http": { "userAgent": "default", "delayMs": 400 },
  "fallback": "readability"
}
