{
  "schemaVersion": 1,
  "id": "sport24-olympiacos",
  "name": "Sport24 — Ολυμπιακός",
  "homepage": "https://www.sport24.gr/tag/olympiacos/",
  "enabled": true,
  "discovery": {
    "type": "html-list",
    "url": "https://www.sport24.gr/tag/olympiacos/",
    "maxItems": 30
  },
  "listSelectors": {
    "item": "article.article_card",
    "link": "h2.article_card__title a@href",
    "title": "h2.article_card__title span.desktop_title",
    "image": "figure img@data-src"
  },
  "article": {
    "title": "h1.single_article__title",
    "author": ".single_article__byline__author",
    "date": "meta[property=article:published_time]@content",
    "leadImage": "meta[property=og:image]@content",
    "content": "article.single_article",
    "remove": [
      "header.single_article__header",
      "footer",
      ".single_article_social",
      ".article__tags_container",
      ".seo_promo",
      ".ads_element",
      ".dfp-wrap",
      "[id^=phaistos]",
      "svg",
      "button"
    ]
  },
  "urlRules": {
    "deny": ["/matchcenter/", "/tvprogram/"],
    "stripQueryParams": ["utm_source", "utm_medium", "utm_campaign", "fbclid"]
  },
  "http": {
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    "delayMs": 600
  },
  "fallback": "readability"
}
