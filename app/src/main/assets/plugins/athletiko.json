{
  "schemaVersion": 1,
  "id": "athletiko-olympiacos",
  "name": "Athletiko — Ολυμπιακός",
  "homepage": "https://www.athletiko.gr/olympiakos",
  "enabled": true,
  "discovery": {
    "type": "html-list",
    "url": "https://www.athletiko.gr/olympiakos",
    "maxItems": 16
  },
  "listSelectors": {
    "item": "article.rounded-lg",
    "link": "h2 a@href",
    "title": "h2 a",
    "image": "img@src"
  },
  "article": {
    "title": "h1",
    "author": "meta[name=author]@content",
    "date": "meta[property=article:published_time]@content",
    "leadImage": "meta[property=og:image]@content",
    "content": "div.html-content",
    "remove": ["div.bg-black.text-white.px-8", ".ad__div"]
  },
  "urlRules": {
    "stripQueryParams": ["utm_source", "utm_medium", "utm_campaign", "fbclid"]
  },
  "http": { "userAgent": "default", "delayMs": 400 },
  "fallback": "readability"
}
