{
  "schemaVersion": 1,
  "id": "sportfm-olympiacos",
  "name": "Sport-FM — Ολυμπιακός",
  "homepage": "https://www.sport-fm.gr/tag/olympiakos",
  "enabled": true,
  "discovery": {
    "type": "rss",
    "url": "https://www.sport-fm.gr/tag/olympiakos.feed",
    "maxItems": 30
  },
  "article": {
    "title": "h1.post-title",
    "leadImage": "meta[property=og:image]@content",
    "content": "#article-content",
    "remove": [
      ".content-box",
      ".inarticleDFPbanner",
      ".wrap-video-container",
      "[id^=sas_]",
      "[id^=div-gpt-ad]",
      "svg",
      "button"
    ]
  },
  "urlRules": {
    "stripQueryParams": ["utm_source", "utm_medium", "utm_campaign", "fbclid"]
  },
  "http": { "userAgent": "default", "delayMs": 400 },
  "fallback": "readability"
}
