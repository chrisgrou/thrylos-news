{
  "schemaVersion": 1,
  "id": "gazzetta-olympiacos",
  "name": "Gazzetta — Ολυμπιακός",
  "homepage": "https://www.gazzetta.gr/teams/olympiakos",
  "enabled": true,
  "discovery": {
    "type": "html-list",
    "url": "https://www.gazzetta.gr/teams/olympiakos",
    "maxItems": 25
  },
  "listSelectors": {
    "item": "article.is-flex.mb-32",
    "link": "h3 a@href",
    "title": "h3 a",
    "image": "img@src"
  },
  "article": {
    "title": "h1.h1",
    "author": "span.authoring__author",
    "date": "time.authoring__time@datetime",
    "leadImage": "meta[property=og:image]@content",
    "content": "div.content.is-relative",
    "remove": [".summary-list", ".content__lead", ".in_read_dfp", ".sharing"]
  },
  "urlRules": {
    "stripQueryParams": ["utm_source", "utm_medium", "utm_campaign", "fbclid"]
  },
  "http": { "userAgent": "default", "delayMs": 400 },
  "fallback": "readability"
}
